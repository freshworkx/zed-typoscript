@import 'EXT:site_package/Configuration/TypoScript/constants.typoscript'

# Single line comment
// Another single line comment
/* Block
   comment */

lib.content = COA
lib.content {
  10 = TEXT
  10.value = Hello {$plugin.tx_site.settings.name}
  10.wrap = <h1>|</h1>
  20 = FLUIDTEMPLATE
  20 {
    templateName = Default
    templateRootPaths.10 = EXT:site_package/Resources/Private/Templates/
  }
}

page = PAGE
page {
  typeNum = 0
  10 < lib.content
  20 =< lib.content
  30 >
  includeCSS.main = EXT:site_package/Resources/Public/Css/main.css
  headerData.10 (
    <meta name="robots" content="index,follow">
  )
}

plugin.tx_site.settings.items := addToList(foo,bar)

[frontend.user.isLoggedIn && request.getQueryParams()['debug'] == 1]
  config.debug = 1
[ELSE]
  config.debug = 0
[END]

[applicationContext == "Development" and traverse(request.getQueryParams(), 'x') in [1, 2]]
  config.contentObjectExceptionHandler = 0
[GLOBAL]
